# Exercise the executable so parsing, backend selection, and linking are tested together.
function(check_cli expected_status expected_text)
    execute_process(
        COMMAND "${ENGINE}" ${ARGN}
        RESULT_VARIABLE status
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error
    )
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "Arguments: ${ARGN}\nExpected exit ${expected_status}, got ${status}\n${output}${error}")
    endif()
    string(FIND "${output}${error}" "${expected_text}" match)
    if(match EQUAL -1)
        message(FATAL_ERROR "Arguments: ${ARGN}\nMissing: ${expected_text}\n${output}${error}")
    endif()
    set(cli_output "${output}" PARENT_SCOPE)
endfunction()

check_cli(0 "Backend: cpu" --backend cpu --samples 257)
string(FIND "${cli_output}" "GPU kernel interval" gpu_timing)
if(NOT gpu_timing EQUAL -1)
    message(FATAL_ERROR "CPU output must not report GPU timing")
endif()
string(FIND "${cli_output}" "CPU input scan time" scan_timing)
if(NOT scan_timing EQUAL -1)
    message(FATAL_ERROR "CPU backend output must not report CUDA input scan timing")
endif()
check_cli(0 "Backend: cpu" --samples 257)
check_cli(0 "--backend" --help)
check_cli(1 "Backend must be cpu or cuda" --backend invalid)
check_cli(1 "Missing value after --backend" --backend)

check_cli(0 "--input" --help)
check_cli(1 "Missing value after --input" --input)
set(example "${CMAKE_CURRENT_LIST_DIR}/../data/example.csv")
check_cli(1 "--input cannot be combined" --input "${example}" --samples 4)
check_cli(1 "--input cannot be combined" --samples 4 --input "${example}")
check_cli(1 "--input cannot be combined" --input "${example}" --seed 42)
check_cli(1 "--input cannot be combined" --seed 42 --input "${example}")

set(csv_dir "${CMAKE_CURRENT_BINARY_DIR}/cli_csv")
file(MAKE_DIRECTORY "${csv_dir}")
check_cli(1 "Cannot open input file:" --input "${csv_dir}/missing.csv")
file(WRITE "${csv_dir}/invalid.csv" "measurement,reference\n1,1\n2,broken\n")
check_cli(1 "CSV line 3:" --input "${csv_dir}/invalid.csv")
file(WRITE "${csv_dir}/empty.csv" "measurement,reference\n")

set(backends cpu)
if(CUDA_ENABLED)
    list(APPEND backends cuda)
endif()
foreach(backend IN LISTS backends)
    check_cli(0 "Backend: ${backend}" --backend "${backend}" --input "${example}" --threshold 1)
    foreach(expected IN ITEMS "Input file:" "Samples: 4\n" "Violations: 2\n"
                              "Maximum absolute error: 4\n" "Mean squared error: 5.0625\n")
        string(FIND "${cli_output}" "${expected}" match)
        if(match EQUAL -1)
            message(FATAL_ERROR "CSV ${backend} output missing: ${expected}\n${cli_output}")
        endif()
    endforeach()
    foreach(forbidden IN ITEMS "Seed:" "Injected anomalies:")
        string(FIND "${cli_output}" "${forbidden}" match)
        if(NOT match EQUAL -1)
            message(FATAL_ERROR "CSV output must not invent synthetic metadata: ${forbidden}")
        endif()
    endforeach()
    check_cli(0 "Samples: 0\n" --backend "${backend}" --input "${csv_dir}/empty.csv")
endforeach()

if(CUDA_ENABLED)
    check_cli(0 "Backend: cuda" --backend cuda --samples 257)
    string(REGEX MATCH "Median GPU kernel interval \\(ms\\): [0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?" gpu_timing "${cli_output}")
    if(gpu_timing STREQUAL "")
        message(FATAL_ERROR "CUDA output must report a nonnegative numeric kernel interval\n${cli_output}")
    endif()
    string(FIND "${cli_output}" "CPU input scan time" scan_timing)
    if(NOT scan_timing EQUAL -1)
        message(FATAL_ERROR "CUDA output must not report the removed CPU scan timer\n${cli_output}")
    endif()
    check_cli(0 "Median GPU kernel interval (ms): 0" --backend cuda --samples 0)
else()
    check_cli(1 "CUDA backend is unavailable in this build" --backend cuda --samples 257)
endif()
